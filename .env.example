# ---------------------------------------------------------------------------
# OmniAgent configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO

# API (binds localhost by default; expose deliberately, never casually)
API_HOST=localhost
API_PORT=8000
# If set, all /api/v1 requests must send X-API-Key. Unset = no auth.
API_KEY=

# Database (assembled into a URL by app.core.config)
DB_USER=omniagent
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omniagent

# LLM backend (OpenAI-compatible; Ollama by default, vLLM/API later)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_FAST_MODEL=llama3.2:3b
LLM_API_KEY=ollama
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2

# Embeddings + reranker (local CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Ingestion
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Hybrid retrieval
RETRIEVAL_TOP_K=8
FUSION_TOP_N=20
RRF_K=60
RERANK_TOP_K=5
HYBRID_ENABLED=true
RERANK_ENABLED=true

# Agent graph
MAX_REFLECTIONS=2
REFUSAL_MIN_EVIDENCE=3

# Evaluation
EVAL_GOLDEN_PATH=evals/golden/queries.jsonl

# LLM fallback (off by default: local-first; enables automated routing to a commercial API)
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
